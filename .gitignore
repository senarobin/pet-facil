# Raiz: espelha os .gitignore de backend/ e frontend/
# (regras especificas ficam em cada subpasta)

# Fallback global - garante que .env nunca seja commitado mesmo na raiz
.env
.env.local
.env.development.local
.env.production.local
backend/.env
frontend/.env

# Dependencias (caso alguem rode npm na raiz por engano)
node_modules/
package-lock.json

# Expo / build (caso haja artefatos na raiz)
.expo/
.expo-shared/
dist/
build/
web-build/
coverage/

# SO / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.log*
yarn-debug.log*
*.log

# Pasta legada da migracao (se ainda existir)
pet_shop/
